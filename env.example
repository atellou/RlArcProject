# AWS Configurations
AWS_ACCOUNT_ID=<Account ID>
AWS_REGION=<Region>
AWS_SAGEMAKER_BUCKET=<Name of S3 bucket>
AWS_SAGEMAKER_ROLE_ARN=<Role ARN for SageMaker>
AWS_ECR_REPOSITORY=<Repository Name>
AWS_ECR_IMAGE_URI="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${AWS_ECR_REPOSITORY}"
